  },
  {
   "i": 99,
   "k": "text",
   "hu": "Tachográfadatok letöltése, kiértékelése és archiválása"
  },
  {
   "i": 100,
   "k": "text",
   "hu": "Nagy teljesítményű Windows szoftver digitális tachográfadatok kiértékelésére, az EU-s vezetési és pihenőidőre, valamint a HGV munkaidő-irányelvre – egy járműtől a nagyvállalati flottákig skálázható."
  },
  {
   "i": 101,
   "k": "text",
   "hu": "Megfelelőségi motor"
  },
  {
   "i": 102,
   "k": "text",
   "hu": "EU-s vezetési és pihenőidő + munkaidő-irányelv"
  },
  {
   "i": 103,
   "k": "text",
   "hu": "A következők automatikus kiértékelése:"
  },
  {
   "i": 104,
   "k": "text",
   "hu": "(EC) 561/2006 rendelet"
