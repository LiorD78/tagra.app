   "i": 66,
   "k": "text",
   "en": "tmx-consent-v1"
  },
  {
   "i": 67,
   "k": "text",
   "en": "tagra.app (localStorage)"
  },
  {
   "i": 68,
   "k": "text",
   "en": "Remembers your cookie choice"
  },
  {
   "i": 69,
   "k": "text",
   "en": "Always (strictly necessary)"
  },
  {
   "i": 70,
   "k": "text",
   "en": "_ga, _ga_<id>"
  },
  {
   "i": 71,
   "k": "text",
   "en": "Google Analytics 4"
  },
  {
   "i": 72,
   "k": "text",
   "en": "Distinguish users and sessions, usage statistics"
  },
  {
   "i": 73,
   "k": "text",
   "en": "Only after consent (up to 2 years)"
  },
  {
   "i": 74,
   "k": "text",
   "en": "_clck, _clsk, CLID, MUID, ANONCHK, SM"
  },
  {
   "i": 75,
   "k": "text",
   "en": "Microsoft Clarity"
  },
  {
   "i": 76,
   "k": "text",
   "en": "Aggregated session insights and heatmaps"
  },
  {
   "i": 77,
   "k": "text",
   "en": "Only after consent (up to 1 year)"
  },
  {
   "i": 78,
   "k": "text",
   "en": "You can change your decision at any time:"
  },
  {
   "i": 79,
   "k": "text",
   "en": "Change cookie preferences"
  },
  {
   "i": 80,
   "k": "text",
   "en": "5. Who we share data with (processors)"
  },
  {
   "i": 81,
   "k": "text",
   "en": "We do not sell your personal data. We share it only with service providers (“processors”) who act on our instructions:"
  },
  {
   "i": 82,
   "k": "text",
   "en": "Google Ireland Ltd."
  },
  {
   "i": 83,
   "k": "text",
   "en": "— Google Analytics 4 (website analytics), only with your consent."
  },
  {
   "i": 84,
   "k": "text",
   "en": "Microsoft Ireland Operations Ltd."
  },
  {
   "i": 85,
   "k": "text",
   "en": "— Microsoft Clarity (session insights), only with your consent."
  },
  {
   "i": 86,
   "k": "text",
   "en": "Resend (Plus Five Five, Inc.)"
  },
  {
   "i": 87,
   "k": "text",
   "en": "— delivery of the trial e-mail you request."
  },
  {
   "i": 88,
   "k": "text",
   "en": "Netlify, Inc."
  },
  {
   "i": 89,
   "k": "text",
   "en": "— website hosting and content delivery (server/security logs)."
  },
  {
   "i": 90,
   "k": "text",
   "en": "Webglobe, s.r.o."
  },
  {
   "i": 91,
   "k": "text",
   "en": "— hosting of our"
  },
  {
   "i": 92,
   "k": "text",
   "en": "sales@tagra.app"
  },
  {
   "i": 93,
   "k": "text",
   "en": "mailbox for correspondence."
  },
  {
   "i": 94,
   "k": "text",
   "en": "6. International transfers"
  },
  {
   "i": 95,
   "k": "text",
   "en": "Some of the providers above may process data outside the European Economic Area (for example in the USA). Where they do, the transfer is covered by appropriate safeguards such as the EU Standard Contractual Clauses and, where applicable, the EU–US Data Privacy Framework."
  },
  {
   "i": 96,
   "k": "text",
   "en": "7. How long we keep your data"
  },
  {
   "i": 97,
   "k": "text",
   "en": "Trial enquiries"
  },
  {
   "i": 98,
   "k": "text",
   "en": "— (name, e-mail, correspondence): up to 24 months from our last contact, unless you ask us to delete them sooner."
  },
  {
   "i": 99,
   "k": "text",
   "en": "Analytics"
  },
  {
   "i": 100,
   "k": "text",
   "en": "— retained according to Google and Microsoft settings (Google Analytics up to 14 months)."
  },
  {
   "i": 101,
   "k": "text",
   "en": "Your cookie choice"
  },
  {
   "i": 102,
   "k": "text",
   "en": "— stored on your device until you clear it or change it."
  },
  {
   "i": 103,
   "k": "text",
   "en": "8. Your rights"
  },
  {
   "i": 104,
   "k": "text",
   "en": "Under the GDPR you have the right to: access your data; have it corrected or erased; restrict or object to its processing; data portability; and to withdraw consent at any time (use the button in section 4 to reopen the cookie banner). Withdrawing consent does not affect processing carried out before withdrawal."
  },
  {
   "i": 105,
   "k": "text",
   "en": "To exercise any right, e-mail"
  },
  {
   "i": 106,
   "k": "text",
   "en": "sales@tagra.app"
  },
  {
   "i": 107,
   "k": "text",
   "en": ". You also have the right to lodge a complaint with the Czech supervisory authority, the"
  },
  {
   "i": 108,
   "k": "text",
   "en": "Office for Personal Data Protection"
  },
  {
   "i": 109,
   "k": "text",
   "en": "(Úřad pro ochranu osobních údajů), Pplk. Sochora 27, 170 00 Prague 7,"
  },
  {
   "i": 110,
   "k": "text",
   "en": "uoou.gov.cz"
  },
  {
   "i": 111,
   "k": "text",
   "en": "9. Changes to this notice"
  },
  {
   "i": 112,
   "k": "text",
   "en": "We may update this notice as our services or legal obligations change. The current version always lives at this page, with the “last updated” date shown at the top."
