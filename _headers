# ────────────────────────────────────────────────
# Security headers — applied to ALL responses
# ────────────────────────────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Content-Security-Policy — omezuje, odkud se smí načítat kód a obsah.
  # 'unsafe-inline' u skriptů je nutné: web má 731 inline <script> bloků
  # (souhlas s cookies, navigace, přepínače) a 237 <style> bloků. Politika
  # tedy neblokuje inline kód, ale blokuje načtení čehokoli z neznámé domény
  # — což je hlavní ochrana proti kompromitované třetí straně.
  # Povolené domény: Google Tag Manager a Analytics, Microsoft Clarity,
  # obrázkové CDN TRUCKMALL, vlajky (flagcdn), formuláře Netlify, Smartsupp.
  #
  # POZOR U SMARTSUPPU — widget sahá na tři různé domény a každá selže jinak:
  #   smartsuppchat.com   loader, bootstrap, API
  #   smartsuppcdn.com    kód widgetu, stylesheet, překlady
  #   smartsupp.com       WebSocket (wss://websocket-visitors.smartsupp.com)
  # Bez smartsupp.com se widget spustí, ale nevykreslí tlačítko a mlčky selže.
  # Bez smartsuppcdn.com ve style-src se tlačítko vykreslí BEZ STYLŮ — černý
  # průhledný obdélník místo modré bubliny. Stylesheet se tahá jako <link>,
  # takže 'unsafe-inline' na něj nestačí.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://*.clarity.ms https://www.smartsuppchat.com https://*.smartsuppcdn.com; style-src 'self' 'unsafe-inline' https://*.smartsuppcdn.com https://*.smartsuppchat.com; img-src 'self' data: blob: https://cdn.truckmall.cz https://flagcdn.com https://www.google-analytics.com https://www.googletagmanager.com https://*.clarity.ms https://*.smartsuppcdn.com https://*.smartsuppchat.com https://*.smartsupp.com; font-src 'self' data: https://*.smartsuppcdn.com; media-src 'self' https://cdn.truckmall.cz https://*.smartsuppcdn.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://*.smartsuppchat.com https://*.smartsuppcdn.com https://*.smartsupp.com wss://*.smartsuppchat.com wss://*.smartsupp.com; frame-src 'self' https://*.smartsuppchat.com https://*.smartsuppcdn.com https://*.smartsupp.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# ────────────────────────────────────────────────
# HTML — short cache, must revalidate, stale-while-revalidate for speed
# ────────────────────────────────────────────────
/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

# Sub-pages without .html extension (Netlify pretty URLs)
/fleet/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/driver/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/enforcement/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/how-it-works/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/for-whom/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/faq/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/contact/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/integrations/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/articles/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

/try/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400

# /try/try.js is a single small file — own override (CSS rule below catches main.css)
/try/try.js
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/javascript; charset=UTF-8

# ────────────────────────────────────────────────
# Static assets — aggressive caching (1 year, immutable)
# ────────────────────────────────────────────────
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Hero poster: override the 1-year immutable cache above so a new
# deploy can replace it. Cache-bust via ?v=… is the canonical strategy,
# but this is an extra safety net for anyone who somehow misses it.
/assets/img/hero-poster.jpg
  Cache-Control: public, max-age=300, must-revalidate

# Hero background videos — short cache, always revalidate
/assets/video/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/css; charset=UTF-8

# nav.js se meni casteji, nez se stiha bumpovat ?v= na 111 strankach.
# 24h cache znamenala, ze oprava chatu nedorazila k vracejicim se
# navstevnikum cely den. 5 minut + revalidace je rozumny kompromis:
# soubor ma 4 kB, revalidace je 304 bez tela.
/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

# ────────────────────────────────────────────────
# XML / TXT / JSON metadata
# ────────────────────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=UTF-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

# IndexNow + verification files
/*.txt
  Cache-Control: public, max-age=3600
